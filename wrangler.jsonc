{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "jagdish-dune-palace",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules"
  ],
  "minify": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}