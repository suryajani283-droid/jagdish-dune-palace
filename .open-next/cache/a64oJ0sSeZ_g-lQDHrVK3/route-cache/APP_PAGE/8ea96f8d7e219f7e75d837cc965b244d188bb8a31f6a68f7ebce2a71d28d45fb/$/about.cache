c=\"\"></script><script src=\"/_next/static/chunks/3fqna72j4cxgm.js\" async=\"\"></script><title>Jagdish Dune Palace | Luxury Desert Heritage</title><meta name=\"description\" content=\"A luxury boutique hotel in Chohtan, Barmer, Rajasthan.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-lato bg-[var(--theme-bg)] text-[#2a2520] antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm\"><div class=\"bg-[var(--theme-primary)] text-stone-300 text-xs py-2 hidden md:block\"><div class=\"max-w-7xl mx-auto px-6 flex justify-between items-center\"><div class=\"flex gap-6 font-medium tracking-wide\"><span>📞 +91 7599936000</span><span>✉️ stay@jagdishdunepalace.com</span></div><div class=\"flex gap-1 text-xs\"><button class=\"px-2 py-1 bg-[var(--theme-secondary)] text-white\">EN</button><button class=\"px-2 py-1 text-stone-600\">हिं</button></div></div></div><div class=\"max-w-7xl mx-auto px-6 py-4 flex items-center justify-between\"><a class=\"flex items-center gap-4 group\" href=\"/\"><div class=\"w-16 h-16 md:w-20 md:h-20 rounded-full border-2 text-[var(--theme-secondary)] flex items-center justify-center font-serif text-3xl font-bold text-[var(--theme-primary)] group-hover:bg-[var(--theme-primary)] group-hover:text-white transition-all duration-300 shadow-md shrink-0\">J</div><div class=\"flex flex-col\"><span class=\"text-xl md:text-3xl font-serif font-bold text-[var(--theme-primary)] tracking-wide uppercase leading-tight group-hover:text-[var(--theme-secondary)] transition-colors\">Jagdish Dune</span><span class=\"text-[10px] md:text-xs uppercase tracking-[0.4em] text-[var(--theme-secondary)] font-sans font-bold text-left mt-1\">Palace</span></div></a><nav class=\"hidden lg:flex items-center gap-6 text-xs uppercase tracking-widest font-bold text-stone-600\"><a class=\"hover:text-[var(--theme-secondary)] transition-colors\" href=\"/\">Home</a><a class=\"hover:text-[var(--theme-secondary)] transition-colors\" href=\"/rooms\">Rooms</a><a class=\"hover:text-[var(--theme-secondary)] transition-colors\" href=\"/facilities\">Facilities</a><a class=\"hover:text-[var(--theme-secondary)] transition-colors\" href=\"/gallery\">Gallery</a><a class=\"hover:text-[var(--theme-secondary)] transition-colors\" href=\"/offers\">Offers</a><a class=\"hover:text-[var(--theme-secondary)] transition-colors\" href=\"/contact\">Contact</a><a class=\"ml-4 text-[var(--theme-primary)] hover:text-[var(--theme-secondary)] transition-colors border border-stone-300 px-3 py-2 rounded-sm\" href=\"/customer/login\">Login</a><a class=\"bg-[var(--theme-primary)] text-[var(--theme-secondary)] border text-[var(--theme-secondary)] hover:bg-[var(--theme-primary)] hover:text-[var(--theme-primary)] transition-all duration-300 py-3 px-6 ml-2 font-bold shadow-md\" href=\"/booking\">Book Now</a></nav><button class=\"lg:hidden text-2xl text-[var(--theme-primary)]\">☰</button></div></header><div class=\"max-w-4xl mx-auto px-6 py-20 text-center\"><h1 class=\"text-5xl font-serif font-bold mb-6\">Our Story</h1><div class=\"w-24 h-1 bg-[var(--theme-secondary)] mx-auto mb-8\"></div><p class=\"text-lg text-stone-600 leading-relaxed mb-6\">Welcome to Jagdish Dune Palace, a sanctuary of luxury nestled in the heart of the Thar Desert in Chohtan, Barmer. Our heritage property offers a perfect blend of traditional Rajasthani hospitality and modern comfort.</p><p class=\"text-lg text-stone-600 leading-relaxed\">Every corner of our palace tells a story of royalty, crafted with intricate architecture, golden sands, and breathtaking sunsets. Whether you are seeking a peaceful retreat or an adventurous desert safari, we promise an unforgettable experience.</p></div><footer class=\"bg-[var(--theme-primary)] text-stone-300 py-16 mt-20 border-t-4 text-[var(--theme-secondary)]\"><div class=\"max-w-7xl mx-auto px-6 grid md:grid-cols-4 gap-10\"><div class=\"md:col-span-1\"><h3 class=\"text-[var(--theme-secondary)] text-2xl font-serif mb-4\">Jagdish Dune Palace</h3><p class=\"text-sm leading-relaxed text-stone-400 mb-6\">A luxury heritage hotel nestled in the golden sands of Chohtan, Barmer. Experience the royal Rajasthani hospitality.</p><div class=\"flex gap-4\"><a href=\"https://www.instagram.com/jagdishpalacechohtan\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[var(--theme-primary)] hover:text-[var(--theme-primary)] transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"20\" height=\"20\" x=\"2\" y=\"2\" rx=\"5\" ry=\"5\"></rect><path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path><line x1=\"17.5\" x2=\"17.51\" y1=\"6.5\" y2=\"6.5\"></line></svg></a><a href=\"https://wa.me/919876543210\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[var(--theme-primary)] hover:text-[var(--theme-primary)] transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg></a></div></div><div><h4 class=\"text-white font-semibold mb-4 uppercase te